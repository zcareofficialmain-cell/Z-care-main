# ============================================================
# ZCare Healthcare Platform — Environment Variables
# ============================================================

# Supabase Backend Configuration
# Obtain these from your Supabase Dashboard: Project Settings -> API
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-supabase-anon-or-publishable-key

# Optional: Set to true if you wish to enforce strict production payment checks
VITE_PAYMENT_TEST_MODE=true

# Note: ZCare uses deterministic client-side PDF.js and Tesseract.js OCR.
# No external generative AI API key is required.

