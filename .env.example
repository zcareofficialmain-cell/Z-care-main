# ============================================================
# ZCare Healthcare Platform — Environment Variables
# ============================================================

# Supabase Backend Configuration
# Obtain these from your Supabase Dashboard: Project Settings -> API
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-supabase-anon-or-publishable-key

# Razorpay Configuration
VITE_RAZORPAY_KEY_ID=rzp_test_or_live_key_id

# Server-side Environment Variables (configured in Vercel project settings)
RAZORPAY_KEY_ID=rzp_test_or_live_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
# Required: the same secret you enter for the webhook in the Razorpay Dashboard
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret
SUPABASE_SERVICE_ROLE_KEY=your_supabase_secret_key

# Optional: Set to true if you wish to enforce strict production payment checks
VITE_PAYMENT_TEST_MODE=true

# Note: ZCare uses deterministic client-side PDF.js and Tesseract.js OCR.
# No external generative AI API key is required.

